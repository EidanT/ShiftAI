# === Servicio ===
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8001
SERVICE_LOG_LEVEL=INFO
UVICORN_LOG_LEVEL=INFO
UVICORN_ERROR_LOG_LEVEL=INFO
UVICORN_ACCESS_LOG_LEVEL=INFO

# === CV Processing ===
CV_MAX_SIZE_BYTES=15728640
CV_MAX_PAGES=200
CV_OCR_MIN_CHARS=30
CV_OCR_DPI=200
CV_REQUEST_TIMEOUT_SECONDS=60
CV_TESSERACT_CMD=

# === Rate limiting (CV endpoints) ===
CV_RATE_LIMIT_PER_MINUTE=10

# === LLM Provider ===
# El provider se autodetecta de LLM_BASE_URL. Para forzar uno específico:
#   openai_compatible | ollama | anthropic
LLM_PROVIDER=auto
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY="api-key"
LLM_MODEL="modelo"
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=80000
LLM_TIMEOUT_SECONDS=60
