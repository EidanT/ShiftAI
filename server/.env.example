PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Opcional: solo es necesario para los modulos conectados a Supabase.
# Deja estas variables comentadas para ejecutar Capacitaciones localmente.
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_JWKS_URL=https://tu-proyecto.supabase.co/auth/v1/.well-known/jwks.json

# Capacitaciones funciona localmente sin modificar Supabase.
# El archivo se crea automaticamente con datos iniciales en cada maquina.
TRAINING_STORAGE=local
TRAINING_DATA_PATH=.local-data/training.json
