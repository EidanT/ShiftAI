PORT=3000
NODE_ENV=development
LOG_LEVEL=debug


# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_JWKS_URL=https://tu-proyecto.supabase.co/auth/v1/.well-known/jwks.json


# Usa "supabase" para compartir los datos entre todos los usuarios.
# Cambia a "local" solamente para ejecutar el módulo sin Supabase.
TRAINING_STORAGE=supabase
TRAINING_DATA_PATH=.local-data/training.json